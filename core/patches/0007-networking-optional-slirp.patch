+# NetState (src/libretro/net/net.cpp) is compiled unconditionally and needs melonDS::Net,
+# even when networking is disabled; only the libslirp driver is optional.
+target_sources(melondsds_libretro PRIVATE
+    ${melonDS_SOURCE_DIR}/src/net/Net.cpp
