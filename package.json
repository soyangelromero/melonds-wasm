{
  "name": "melonds-wasm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "melonDS DS v1.4.0 ported to WebAssembly with a minimal libretro host",
  "license": "GPL-3.0",
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "scripts": {
    "build": "node -e \"console.error('Use scripts/build.ps1 (Windows) or scripts/build.sh (POSIX)')\" && exit 1",
    "serve": "node scripts/serve.mjs",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "test:library": "node tests/library-browser.mjs",
    "test:library-fallback": "node tests/library-fallback-browser.mjs",
    "test:phase7": "node tests/phase7-browser.mjs",
    "test:coi": "node tests/coi-sw-browser.mjs",
    "test:bench": "node tests/bench-browser.mjs",
    "test:bench:quick": "node tests/bench-browser.mjs --quick",
    "test:decimation": "node tests/decimation-browser.mjs",
    "test:fallback-emulatorjs": "node tests/fallback-emulatorjs-browser.mjs",
    "test:fsa": "node tests/fsa-saves-browser.mjs",
    "test:remote": "node tests/hub-remote-smoke.mjs",
    "check:clean": "node scripts/check-clean.mjs",
    "test:browser": "node tests/phase3-browser.mjs tests/artifacts/nmap.nds",
    "test:layouts": "node tests/phase3-layouts.mjs tests/artifacts/nmap.nds",
    "test:audio-core": "node tests/phase4-core-audio.mjs",
    "test:browser:audio": "node tests/phase4-browser.mjs --gl=swiftshader --minutes=3",
    "build:tone-rom": "python3 tests/homebrew/audio-tone/mkrom.py tests/artifacts/audio-tone.nds",
    "test:input": "node tests/phase5-core.mjs tests/artifacts/nmap.nds && node tests/phase5-browser.mjs tests/artifacts/nmap.nds",
    "test:saves": "node --test tests/phase6-saves.mjs",
    "test:saves-browser": "node tests/phase6-browser.mjs",
    "build:integration-rom": "python3 tests/homebrew/integration/mkrom.py tests/artifacts/integration.nds",
    "test:integration": "node tests/integration-browser.mjs --gl=swiftshader",
    "test:webapp": "node tests/phase11-browser.mjs",
    "test:netplay": "node tests/phase12-browser.mjs",
    "package": "node scripts/package.mjs",
    "test:cheats": "node --test tests/cheats.test.mjs tests/cheats-memory.test.mjs",
    "patch:memory": "node scripts/raise-memory-limit.mjs",
    "test:remote:tunnel": "node tests/remote-tunnel-browser.mjs",
    "test:memory-limit": "node --test --test-force-exit tests/memory-limit.test.mjs",
    "test:cross-browser": "node tests/cross-browser-smoke.mjs",
    "release": "node scripts/release.mjs",
    "test:release": "node --test --test-force-exit tests/release.test.mjs",
    "test:third-party": "node tests/third-party-release.mjs"
  }
}
