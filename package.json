{
  "name": "melonds-wasm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "melonDS DS v1.4.0 ported to WebAssembly with a minimal libretro host",
  "license": "GPL-3.0",
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "scripts": {
    "build": "node -e \"console.error('Use scripts/build.ps1 (Windows) or scripts/build.sh (POSIX)')\" && exit 1",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/phase3-browser.mjs tests/artifacts/nmap.nds",
    "test:layouts": "node tests/phase3-layouts.mjs tests/artifacts/nmap.nds",
    "test:audio-core": "node tests/phase4-core-audio.mjs",
    "test:browser:audio": "node tests/phase4-browser.mjs --gl=swiftshader --minutes=3",
    "build:tone-rom": "python3 tests/homebrew/audio-tone/mkrom.py tests/artifacts/audio-tone.nds",
    "test:input": "node tests/phase5-core.mjs tests/artifacts/nmap.nds && node tests/phase5-browser.mjs tests/artifacts/nmap.nds"
  }
}
